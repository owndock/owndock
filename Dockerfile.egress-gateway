FROM golang:1.26.6-bookworm@sha256:116d58cbd88c1297624acc6e967a060012422bacf9930927e23fb719189c6f36 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.buildTime=${BUILD_TIME}" \
    -o /out/owndock-egress-gateway ./cmd/egress-gateway

FROM gcr.io/distroless/base-debian12:nonroot@sha256:63f52bd27b6aa6555f5d56500b70d7bb0afe51c654905be88a2c1cf967a77b1a
COPY --from=build /out/owndock-egress-gateway /usr/local/bin/owndock-egress-gateway
USER 65532:65532
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/owndock-egress-gateway"]
CMD ["-conf", "/etc/owndock/config.yaml"]
